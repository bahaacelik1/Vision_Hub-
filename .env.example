# --- Ortak ---
NODE_ENV=development

# --- Database (packages/database + apps/api) ---
DATABASE_URL=postgresql://vision:vision@localhost:5432/vision?schema=public

# --- Auth (packages/auth) ---
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:3000

# --- API ---
API_PORT=4000
API_URL=http://localhost:4000

# --- Frontend Apps ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_HUB_URL=http://localhost:3001
NEXT_PUBLIC_SOCIAL_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# --- Storage (S3 uyumlu) ---
S3_ENDPOINT=
S3_BUCKET=vision-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
